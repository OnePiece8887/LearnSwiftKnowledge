LD_RUNPATH_SEARCH_PATHS = $(inherited) /usr/lib/swift '@executable_path/Frameworks' '@loader_path/Frameworks'
LIBRARY_SEARCH_PATHS = $(inherited) "${TOOLCHAIN_DIR}/usr/lib/swift/${PLATFORM_NAME}" /usr/lib/swift $(SDKROOT)/usr/lib/swift
OTHER_LDFLAGS = $(inherited) -l"swiftCoreGraphics" -framework "Accelerate" -framework "Alamofire" -framework "AvoidCrash" -framework "BonMot" -framework "CFNetwork" -framework "CocoaLumberjack" -framework "Combine" -framework "CoreFoundation" -framework "CoreGraphics" -framework "CryptoSwift" -framework "DNSPageView" -framework "DZNEmptyDataSet" -framework "FDFullscreenPopGesture" -framework "FSPagerView" -framework "Foundation" -framework "IQKeyboardCore" -framework "IQKeyboardManagerSwift" -framework "IQKeyboardNotification" -framework "IQKeyboardReturnManager" -framework "IQKeyboardToolbar" -framework "IQKeyboardToolbarManager" -framework "IQTextInputViewNotification" -framework "IQTextView" -framework "KeychainAccess" -framework "Kingfisher" -framework "LEEAlert" -framework "LSDObjcSugar" -framework "MBProgressHUD" -framework "MJRefresh" -framework "Moya" -framework "Photos" -framework "PhotosUI" -framework "QuartzCore" -framework "RxCocoa" -framework "RxRelay" -framework "RxSwift" -framework "SAMKeychain" -framework "SVProgressHUD" -framework "Security" -framework "SnapKit" -framework "SwiftMessages" -framework "SwifterSwift" -framework "SwiftyUserDefaults" -framework "TFYSwiftTabbarKit" -framework "TOCropViewController" -framework "TZImagePickerController" -framework "UIAdapter" -framework "UIKit" -framework "UITableView_FDTemplateLayoutCell" -framework "YYModel" -weak_framework "Combine" -weak_framework "SwiftUI"
